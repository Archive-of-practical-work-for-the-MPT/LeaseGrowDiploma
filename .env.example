# Скопируйте в .env и заполните значения
# Секретный ключ: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Для docker compose: если в SECRET_KEY есть символ $, удваивайте его ($$) — иначе compose подставит «переменные» из .env
SECRET_KEY=your-secret-key-here

# Режим отладки (True/False). В production обязательно False
DEBUG=True

# Разрешённые хосты через запятую (для production укажите домен)
ALLOWED_HOSTS=localhost,127.0.0.1

# Docker (docker-compose на сервере): DEBUG=False; ALLOWED_HOSTS=leasegrow.ru,www.leasegrow.ru
# CSRF_TRUSTED_ORIGINS=https://leasegrow.ru,https://www.leasegrow.ru
# DB_HOST в .env игнорируется в compose — подставляется сервис db

# База данных PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=leasegrow
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# Путь к папке bin PostgreSQL (pg_dump, psql) — на Windows, если не в PATH
PG_BIN_PATH=C:\Program Files\PostgreSQL\ВАША_ВЕРСИЯ\bin

# Yandex SMTP для восстановления пароля (логин — полный email, пароль — пароль приложения)
# https://yandex.ru/support/yandex-360/customers/mail/ru/mail-clients/others
# Основной SMTP порт (SSL) и резервный порт, если основной недоступен
EMAIL_PORT=465
EMAIL_FALLBACK_PORT=2587
EMAIL_HOST_USER=ваш-email@yandex.ru
EMAIL_HOST_PASSWORD=ваш-пароль-приложения

# Тестовая оплата ЮKassa
# shopId: Настройки -> Магазин, секретный ключ: Интеграция -> Ключи API (тестовый)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=